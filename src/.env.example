# Copy these values into Vercel Project Settings -> Environment Variables.
# Keep SONIVOX_API_KEY and OPENROUTER_API_KEY server-side; never use NEXT_PUBLIC_ prefixes.

SONIVOX_API_URL=https://sonivox.onrender.com
SONIVOX_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto

# "preset" uses a voice preset linked to the API key (default).
# Use "legacy" only when the key has no linked preset, and provide SONIVOX_VOICE_ID.
SONIVOX_VOICE_MODE=preset
SONIVOX_VOICE_ID=
